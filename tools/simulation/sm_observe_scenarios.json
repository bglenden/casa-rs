        {"op": "setfeed", "mode": "perfect X Y"},
        {"op": "setfield", "sourcename": "target", "sourcedirection": ["J2000", "10h00m00.0", "-30d00m00.0"]},
        {"op": "setauto", "autocorrwt": 0.0},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "observe", "sourcename": "target", "spwname": "band6", "starttime": "-150s", "stoptime": "150s"}
      ]
    },
    {
