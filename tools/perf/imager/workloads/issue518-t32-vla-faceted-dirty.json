    "facets": 2,
    "wprojplanes": 1,
    "field": "0",
    "spw": "0",
    "channel_start": 0,
    "channel_count": 24,
    "imsize": 512,
    "cell_arcsec": 0.35,
    "weighting": "natural",
    "robust": 0.5,
    "deconvolver": "hogbom",
    "hogbom_iteration_mode": "casa",
    "niter": 0,
    "nmajor": -1,
    "gain": 0.1,
    "threshold_jy": 0.0,
    "minor_cycle_length": 25,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_backend": "rustfft"
  },
  "run": {
    "repeats": 1,
    "profile_repeats": 1,
    "run_label": "issue518-t32-faceted-dirty",
    "storage_label": "external-ssd-wave1-small",
    "ms_staging": "copy",
    "phase_probe": "0",
    "skip_profile": "1",
