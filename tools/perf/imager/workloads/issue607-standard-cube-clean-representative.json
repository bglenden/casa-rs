{
  "schema_version": 1,
  "id": "issue607-standard-cube-clean-representative",
  "mode_id": "standard-cube-clean-representative",
  "description": "Issue #607 representative 24-channel VLA Hogbom cube on the structured Wave 1 sky.",
  "dataset": {
    "key": "wave1-vla-single-small",
    "root_env": "CASA_RS_IMPERF_DATA_ROOT",
    "relative_path": "wave1/vla/single/small/ms/wave1-vla-single-small.ms"
  },
  "imaging": {
    "mode": "clean",
    "specmode": "cube",
    "gridder": "standard",
    "interpolation": "nearest",
    "field": "0",
    "spw": "0",
    "channel_start": 0,
    "channel_count": 24,
    "start": "0",
    "width": "1",
    "imsize": 512,
    "cell_arcsec": 0.35,
    "weighting": "natural",
    "perchanweightdensity": true,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "imaging_fft_backend": "rustfft",
    "deconvolver": "hogbom",
    "hogbom_iteration_mode": "casa",
    "niter": 2,
    "minor_cycle_length": 2,
    "usemask": "user",
    "mask_box": "192,192,319,319",
    "casa_pblimit": -0.2,
    "write_pb": false,
    "pbcor": false,
    "wterm": "none"
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "issue607-cube-clean",
    "storage_label": "external-ssd",
    "evidence_role": "representative_scientific_acceptance",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    }
  },
  "comparison": {
    "mode": "full",
    "products": [".image", ".residual", ".psf", ".sumwt", ".model", ".mask"],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": false,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": false,
    "source_regions": [
      {"id":"structured-sky-core","products":[".image",".residual",".model"],"blc":[192,192],"trc":[319,319]}
    ],
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {"diff_rms_over_right_rms": 0.001},
      "products": {
        ".image": {
          "beam_area_relative": 0.001,
          "beam_kernel_nrmse": 0.001,
          "beam_major_relative": 0.001,
          "beam_minor_relative": 0.001,
          "beam_pa_degrees": 0.1,
          "centroid_pixels": 0.05,
          "integrated_flux_relative": 0.001,
          "peak_relative": 0.001
        }
      }
    }
  }
}
