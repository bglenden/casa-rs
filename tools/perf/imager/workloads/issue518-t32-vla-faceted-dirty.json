      {"id":"facet-seam-y","products":[".image",".residual",".model",".psf"],"blc":[0,252],"trc":[511,259]}
    ],
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {
        "diff_rms_over_right_rms": 0.001,
        "require_topology_parity": true,
