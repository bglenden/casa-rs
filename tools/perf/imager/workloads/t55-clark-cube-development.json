{
  "schema_version": 1,
  "id": "t55-clark-cube-development",
  "mode_id": "t55-standard-clark-cube",
  "description": "Bounded T55 real-data Clark cube development check with repeated major cycles and all final products; not large-data performance acceptance.",
  "dataset": {
    "key": "refim-point-withline",
    "root_env": "CASA_RS_T55_DATA_ROOT",
    "relative_path": "refim_point_withline.ms"
  },
  "imaging": {
    "mode": "clean",
    "specmode": "cube",
    "gridder": "standard",
    "interpolation": "linear",
    "field": "0",
    "spw": "0:8~11",
    "channel_start": 0,
    "channel_count": 4,
    "start": "8",
    "width": "1",
    "imsize": 128,
    "cell_arcsec": 8,
    "weighting": "natural",
    "perchanweightdensity": true,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "imaging_fft_backend": "rustfft",
    "deconvolver": "clark",
    "niter": 9,
    "nmajor": 3,
    "minor_cycle_length": 1,
    "gain": 0.1,
    "threshold_jy": 0,
    "casa_pblimit": -0.2,
    "write_pb": true,
    "pbcor": false,
    "wterm": "none"
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "t55-clark-cube-natural-development",
    "storage_label": "internal-ssd",
    "evidence_role": "bounded_development_correctness",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    },
    "stream_log": true
  },
  "comparison": {
    "mode": "full",
    "products": [".image", ".residual", ".psf", ".sumwt", ".model", ".pb", ".mask"],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": true,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": true,
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {"diff_rms_over_right_rms": 0.001},
      "products": {
        ".image": {"beam_area_relative": 0.001, "beam_kernel_nrmse": 0.001}
      }
    }
  }
}
