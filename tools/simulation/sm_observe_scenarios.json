        {"op": "setspwindow", "spwname": "spw0", "freq": "230GHz", "deltafreq": "15.625MHz", "freqresolution": "15.625MHz", "refcode": "LSRK", "nchannels": 32, "stokes": "XX YY"},
        {"op": "setfeed", "mode": "perfect X Y"},
