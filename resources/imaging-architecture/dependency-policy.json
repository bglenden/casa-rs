 "source_boundaries": [
  {
   "id": "native-science-reconstruction-rust",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-reconstruction/src"
   ],
   "extensions": [
    ".rs"
   ],
   "forbidden_patterns": [
    {
     "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:casa_imaging_runtime|casa_imaging|ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)\\b|\\b(?:casa_imaging_runtime|casa_imaging|ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)::",
     "message": "native science or reconstruction Rust source imports an execution, backend, displaced, or device API"
    }
   ]
  },
  {
   "id": "native-runtime-displaced-isolation",
   "roots": [
    "crates/casa-imaging-runtime/src"
   ],
   "extensions": [
    ".rs"
   ],
   "forbidden_patterns": [
    {
     "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:casa_imaging|casars_imager)\\b|\\b(?:casa_imaging|casars_imager)::",
     "message": "native runtime imports a displaced imaging API"
    }
   ]
  },
  {
   "id": "t17-selected-observation-provider-injection",
   "roots": [
    "crates/casa-ms/src/selected_observation"
   ],
   "extensions": [
    ".rs"
   ],
   "forbidden_patterns": [
    {
     "regex": "\\bopen_measures_runtime\\b|\\bcasa_measures_data\\s*::\\s*(?:MeasuresRuntime|\\{[^}]*\\bMeasuresRuntime\\b)|\\bMeasuresRuntime::(?:open|open_discovered|discover_candidates)\\b|\\bopen_discovered\\b",
     "message": "selected-observation source must receive an injected Measures provider and cannot discover MeasuresRuntime"
    }
   ]
  },
  {
   "id": "t15-private-walking-skeleton",
   "roots": [
    "crates/casa-imaging-runtime/tests/walking_skeleton"
   ],
   "extensions": [
    ".rs"
   ],
   "forbidden_patterns": [
    {
     "regex": "(?m)^\\s*pub\\s+(?:use|struct|enum|trait|type|fn|const|static|mod)\\b|\\binclude!\\s*\\(|#\\s*\\[\\s*path\\s*=",
     "message": "T15 walking-skeleton evidence must remain private test code without redirected source"
    }
   ]
  },
  {
   "id": "rust-imaging-frontends",
   "roots": [
    "crates/casa-provider-contracts/src",
    "crates/casars/src",
    "crates/casars-frontend-services/src",
    "crates/casars-imager/src",
    "crates/casars-python/src"
   ],
   "extensions": [
    ".rs"
   ],
   "forbidden_patterns": [
    {
     "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:casa_imaging_runtime|casa_imaging|ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)\\b|\\b(?:casa_imaging_runtime|casa_imaging|ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)::",
     "message": "Rust frontend imports an execution, displaced imaging backend, or device API"
    },
    {
     "regex": "\\b(?:StandardMfsBackend|StandardMfsMinorCycleBackend)::[A-Za-z_][A-Za-z0-9_]*\\b|\\b(?:standard_mfs_metal_device_available|MTLCreateSystemDefaultDevice|MTLCopyAllDevices|MTLCopyAllDevicesWithObserver)\\s*\\(",
     "message": "Rust frontend selects an imaging backend or inspects a device"
    }
   ]
  },
  {
   "id": "swift-imaging-frontends",
   "roots": [
    "apps/casars-mac/Sources/CasarsMacApp",
    "apps/casars-mac/Sources/CasarsMacCore"
   ],
   "extensions": [
    ".swift"
   ],
   "forbidden_patterns": [
    {
     "regex": "(?m)^\\s*import\\s+(?:Metal|MetalKit)\\b|\\b(?:MTLCreateSystemDefaultDevice|MTLCopyAllDevices|MTLCopyAllDevicesWithObserver|FftBackend|GridBackend|ImagingBackend|BackendEligibility|MetalBackend)\\b|\\bProcessInfo\\.processInfo\\.(?:activeProcessorCount|processorCount)\\b|\\b(?:sysctl|sysctlbyname|host_statistics|host_statistics64)\\s*\\(",
     "message": "Swift frontend inspects a device or selects an imaging backend"
    }
   ]
  }
