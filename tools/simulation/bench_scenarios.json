        {"op": "setfeed", "mode": "perfect X Y"},
        {"op": "setauto", "autocorrwt": 0.0},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "target", "sourcedirection": ["J2000", "10h00m00.0", "-30d00m00.0"]},
        {"op": "observe", "sourcename": "target", "spwname": "band6", "starttime": "-1800s", "stoptime": "1800s"},
        {"op": "setvp", "dovp": true, "usedefaultvp": false},
        {"op": "predict", "imagename": "alma-mfs.image"},
        {"op": "setseed", "seed": 11111},
        {"op": "setnoise", "mode": "simplenoise", "simplenoise": "0.1Jy"},
        {"op": "corrupt"}
      ]
