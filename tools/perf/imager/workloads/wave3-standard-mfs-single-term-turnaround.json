{
  "schema_version": 1,
  "id": "wave3-standard-mfs-single-term-turnaround",
  "mode_id": "standard-mfs-single-term",
  "description": "Issue #540 serial optimization-turnaround row using the matched 32 GiB VLA MeasurementSet and full 1024-pixel Briggs MFS geometry, with one selected channel and 50 Hogbom iterations. This preserves full row traversal, bounded residency, weighting, major/minor-cycle, and product-writing behavior while reducing spectral sample volume; it is not final CASA performance evidence.",
  "dataset": {
    "key": "wave1-vla-single-medium",
    "relative_path": "wave1/vla/single/medium/ms/wave1-vla-single-medium.ms",
    "root_env": "CASA_RS_IMPERF_DATA_ROOT"
  },
  "imaging": {
    "mode": "clean",
    "specmode": "mfs",
    "gridder": "standard",
    "field": "0",
    "spw": "0",
    "channel_start": 0,
    "channel_count": 1,
    "imsize": 1024,
    "cell_arcsec": 0.25,
    "weighting": "briggs",
    "robust": 0.5,
    "deconvolver": "hogbom",
    "hogbom_iteration_mode": "casa",
    "nterms": 1,
    "niter": 50,
    "nmajor": -1,
    "gain": 0.1,
    "threshold_jy": 0.0,
    "minor_cycle_length": 50,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_backend": "rustfft"
  },
  "run": {
    "repeats": 1,
    "run_label": "issue540-serial-turnaround",
    "storage_label": "external-ssd-wave1",
    "ms_staging": "direct",
    "phase_probe": "0",
    "skip_casa": "1",
    "skip_profile": "1",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    },
    "evidence_role": "optimization_turnaround_serial"
  },
  "review": {
    "required_reviewer": "Brian",
    "requires_human_acceptance_before_done": false,
    "required_evidence_roles": [
      "optimization_turnaround_serial"
    ]
  },
  "comparison": {
    "products": [
      ".image",
      ".residual",
      ".psf",
      ".model"
    ],
    "max_elements_per_product": 1000000
  }
}
