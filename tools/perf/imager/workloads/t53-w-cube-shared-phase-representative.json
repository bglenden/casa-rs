{
  "schema_version": 1,
  "id": "t53-w-cube-shared-phase-representative",
  "mode_id": "t53-w-multifield-spectral-join",
  "description": "T53 representative extension of the named #478 refim_point_withline shared-phase multifield W cube, retaining its W=8 geometry and strengthening complete-product coverage.",
  "dataset": {
    "key": "t53-refim-withline-shared-phase",
    "root_env": "CASA_RS_T53_DATA_ROOT",
    "relative_path": "refim-withline-shared-phase.ms"
  },
  "imaging": {
    "mode": "dirty",
    "specmode": "cube",
    "gridder": "wproject",
    "interpolation": "linear",
    "field": "0,1",
    "spw": "0:0~17",
    "channel_start": 0,
    "channel_count": 16,
    "start": "1",
    "width": "1",
    "imsize": 512,
    "cell_arcsec": 8,
    "weighting": "natural",
    "perchanweightdensity": true,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "imaging_fft_backend": "rustfft",
    "deconvolver": "hogbom",
    "niter": 0,
    "minor_cycle_length": 2,
    "casa_pblimit": -0.2,
    "write_pb": true,
    "pbcor": false,
    "wterm": "wproject",
    "wprojplanes": 8
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "t53-w-cube-shared-phase",
    "storage_label": "external-ssd",
    "evidence_role": "representative_scientific_acceptance",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    },
    "stream_log": true
  },
  "comparison": {
    "mode": "full",
    "products": [
      ".image",
      ".residual",
      ".psf",
      ".sumwt",
      ".model",
      ".pb"
    ],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": true,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": true,
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {
        "diff_rms_over_right_rms": 0.001
      },
      "products": {
        ".image": {
          "beam_area_relative": 0.001,
          "beam_kernel_nrmse": 0.001
        }
      }
    }
  }
}
