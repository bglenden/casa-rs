{
  "schema_version": 1,
  "id": "b10-mosaic-mfs-alma-1024-clean",
  "mode_id": "t53-mosaic-mfs",
  "description": "Imaging taxonomy row B10 (#732): the wave1 ALMA seven-pointing mosaic, MFS over the sixteen channels the T53 rows image, 1024² at 0.08″, Briggs 0.5, Högbom clean of 500 iterations, flat-noise, pblimit 0.2, one CPU worker. The 512² dirty row's data at the size where per-sample gridding, not fixed cost, sets the time.",
  "dataset": {
    "key": "wave1-alma-mosaic-small",
    "root_env": "CASA_RS_IMPERF_DATA_ROOT",
    "relative_path": "wave1/alma/mosaic/small/ms/wave1-alma-mosaic-small.ms"
  },
  "imaging": {
    "mode": "clean",
    "specmode": "mfs",
    "gridder": "mosaic",
    "field": "0,1,2,3,4,5,6",
    "spw": "0",
    "channel_start": 1,
    "channel_count": 16,
    "imsize": 1024,
    "cell_arcsec": 0.08,
    "weighting": "briggs",
    "robust": 0.5,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "deconvolver": "hogbom",
    "hogbom_iteration_mode": "casa",
    "niter": 500,
    "threshold_jy": 0.0,
    "minor_cycle_length": 50,
    "write_pb": true,
    "pbcor": true,
    "wterm": "none",
    "phasecenter_field": 0,
    "pblimit": 0.2
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "b10-mosaic-mfs",
    "storage_label": "external-ssd",
    "evidence_role": "representative_scientific_acceptance",
    "stream_log": true
  },
  "comparison": {
    "mode": "full",
    "products": [
      ".image",
      ".residual",
      ".psf",
      ".sumwt",
      ".model",
      ".mask",
      ".weight",
      ".pb",
      ".image.pbcor"
    ],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": true,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": true,
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {
        "diff_rms_over_right_rms": 0.001
      },
      "products": {
        ".image": {
          "beam_area_relative": 0.001,
          "beam_kernel_nrmse": 0.001
        }
      }
    }
  }
}
