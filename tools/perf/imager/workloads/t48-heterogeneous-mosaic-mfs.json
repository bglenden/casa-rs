{
  "schema_version": 1,
  "id": "t48-heterogeneous-mosaic-mfs",
  "mode_id": "mosaic-mfs-heterogeneous",
  "description": "T48 mixed five-ALMA/five-ACA, four-linear-correlation polarized, seven-pointing, 2,016,000-sample 512-pixel MFS correctness oracle.",
  "dataset": {
    "key": "t48-mixed-representative",
    "relative_path": "imaging/t48/t48-mixed-representative.ms",
    "root_env": "CASA_RS_TESTDATA_ROOT"
  },
  "imaging": {
    "mode": "clean",
    "specmode": "mfs",
    "gridder": "mosaic",
    "field": "0,1,2,3,4,5,6",
    "phasecenter_field": 0,
    "spw": "0",
    "channel_start": 0,
    "channel_count": 16,
    "stokes": "Q",
    "imsize": 512,
    "cell_arcsec": 1.0,
    "weighting": "natural",
    "robust": 0.5,
    "perchanweightdensity": true,
    "deconvolver": "hogbom",
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_backend": "rustfft",
    "nterms": 1,
    "niter": 2,
    "minor_cycle_length": 2,
    "pblimit": 0.2,
    "usepointing": true,
    "write_pb": true,
    "pbcor": true,
    "wterm": "none"
  },
  "run": {
    "repeats": 1,
    "run_label": "t48-heterogeneous-mosaic-mfs",
    "storage_label": "representative-testdata",
    "ms_staging": "copy",
    "skip_profile": "1",
    "stream_log": true,
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    }
  },
  "comparison": {
    "mode": "full",
    "products": [
      ".image",
      ".image.pbcor",
      ".model",
      ".pb",
      ".psf",
      ".residual",
      ".sumwt",
      ".weight"
    ],
    "max_elements_per_product": 5000000,
    "full_chunk_elements": 16384,
    "require_exact_product_inventory": false,
    "require_direction_wcs_parity": true,
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {
        "diff_rms_over_right_rms": 0.001,
        "require_topology_parity": true
      },
      "products": {}
    }
  }
}
