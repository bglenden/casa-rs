        {"op": "setspwindow", "spwname": "hi", "freq": "357GHz", "deltafreq": "7.8125MHz", "freqresolution": "7.8125MHz", "refcode": "LSRK", "nchannels": 16, "stokes": "XX XY YX YY"},
        {"op": "setfeed", "mode": "perfect X Y"},
        {"op": "setauto", "autocorrwt": 0.0},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "cal", "sourcedirection": ["J2000", "09h30m00.0", "-25d00m00.0"], "calcode": "C"},
        {"op": "setfield", "sourcename": "target", "sourcedirection": ["J2000", "10h00m00.0", "-30d00m00.0"]},
        {"op": "observe", "sourcename": "cal", "spwname": "lo", "starttime": "-600s", "stoptime": "-540s", "state_obs_mode": "CALIBRATE_PHASE.ON_SOURCE"},
        {"op": "observe", "sourcename": "target", "spwname": "lo", "starttime": "-530s", "stoptime": "-300s"},
        {"op": "observe", "sourcename": "target", "spwname": "hi", "starttime": "-290s", "stoptime": "-100s", "add_observation": true, "observer": "someone", "project": "2026.1.00001.S"},
        {"op": "observe", "sourcename": "cal", "spwname": "hi", "starttime": "-90s", "stoptime": "-30s", "state_obs_mode": "CALIBRATE_PHASE.ON_SOURCE"}
