      "calls": [
        {"op": "setspwindow", "spwname": "spw0", "freq": "100GHz", "deltafreq": "-31.25MHz", "freqresolution": "31.25MHz", "refcode": "TOPO", "nchannels": 8, "stokes": "XX"},
        {"op": "setfeed", "mode": "perfect X Y"},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": false, "referencetime": ["UTC", "2026/03/21/03:00:00"]},
