 "device_dependency_prefixes": [
  "ash",
  "cuda",
  "cudarc",
  "metal",
  "objc2-metal",
  "opencl",
  "vulkano",
  "wgpu"
 ],
 "device_free_layers": [
  "frontend",
  "application",
  "science",
  "observation",
  "reconstruction",
  "product"
 ],
 "source_rules": [
  {
   "id": "device-api-only-in-metal",
   "message": "device APIs are confined to casa-imaging-metal",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-operator/src",
    "crates/casa-imaging-deconvolution/src",
    "crates/casa-imaging-products/src",
    "crates/casa-imaging-application/src",
    "crates/casa-simulation/src",
    "crates/casa-provider-contracts/src",
    "crates/casars/src",
    "crates/casars-imager/src",
    "crates/casars-python/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)\\b|\\b(?:ash|cudarc|objc2_metal|vulkano|wgpu)::|\\b(?:MTLCreateSystemDefaultDevice|MTLCopyAllDevices)\\s*\\(",
   "grandfathered": []
  },
  {
   "id": "no-displaced-imaging-imports",
   "message": "native imaging crates and frontends must not import a displaced or execution API across the layer boundary",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-operator/src",
    "crates/casa-imaging-deconvolution/src",
    "crates/casa-provider-contracts/src",
    "crates/casars/src",
    "crates/casars-imager/src",
    "crates/casars-python/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:casa_imaging_runtime|casa_imaging_metal)\\b|\\b(?:casa_imaging_runtime|casa_imaging_metal)::",
   "grandfathered": []
  },
  {
   "id": "no-env-in-imaging-libraries",
   "message": "library crates on the imaging path read no environment variables: switches are request fields or caller configuration, diagnostics are tracing events (ADR-0016, #658); resolving a relative path against the working directory (std::env::current_dir) is allowed, and the grandfathered data and state discovery waits for #709",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-operator/src",
    "crates/casa-imaging-deconvolution/src",
    "crates/casa-imaging-products/src",
    "crates/casa-imaging-runtime/src",
    "crates/casa-imaging-metal/src",
    "crates/casa-imaging-application/src",
    "crates/casa-simulation/src",
    "crates/casa-fft/src",
    "crates/casa-ms/src",
    "crates/casa-tables/src",
    "crates/casa-images/src",
    "crates/casa-coordinates/src",
    "crates/casa-lattices/src",
    "crates/casa-numerics/src",
    "crates/casa-types/src",
    "crates/casa-values/src",
    "crates/casa-aipsio/src",
    "crates/casa-simulation-synthesis/src",
    "crates/casa-measures-data/src",
    "crates/casa-task-runtime/src"
   ],
   "exclude_roots": [
    "crates/casa-ms/src/bin",
    "crates/casa-ms/src/msexplore/cli.rs",
    "crates/casa-tables/src/bin",
    "crates/casa-images/src/bin"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\benv::var(?:_os)?\\s*\\(|\\bstd::env\\b(?!::current_dir\\b)",
   "grandfathered": [
    "crates/casa-measures-data/src/lib.rs",
    "crates/casa-ms/src/simulation_task.rs",
    "crates/casa-task-runtime/src/storage.rs"
   ]
  },
  {
   "id": "no-eprintln-in-imaging-crates",
   "message": "library crates on the imaging path emit through tracing, never eprintln! (ADR-0016, #658); casa-logging, the tracing sink itself, is not on the list",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-operator/src",
    "crates/casa-imaging-deconvolution/src",
    "crates/casa-imaging-products/src",
    "crates/casa-imaging-runtime/src",
    "crates/casa-imaging-metal/src",
    "crates/casa-imaging-application/src",
    "crates/casa-simulation/src",
    "crates/casa-fft/src",
    "crates/casa-ms/src",
    "crates/casa-tables/src",
    "crates/casa-images/src",
    "crates/casa-coordinates/src",
    "crates/casa-lattices/src",
    "crates/casa-numerics/src",
    "crates/casa-types/src",
    "crates/casa-values/src",
    "crates/casa-aipsio/src",
    "crates/casa-simulation-synthesis/src",
    "crates/casa-measures-data/src",
    "crates/casa-task-runtime/src"
   ],
   "exclude_roots": [
    "crates/casa-ms/src/bin",
    "crates/casa-ms/src/msexplore/cli.rs",
    "crates/casa-tables/src/bin",
    "crates/casa-images/src/bin"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\beprintln!\\s*\\(",
   "grandfathered": []
  },
  {
   "id": "no-content-hashing-in-imaging-crates",
   "message": "no SHA-256 or CRC over scientific arrays, plans, receipts or spill (ADR-0014/0015/0016)",
   "roots": [
    "crates/casa-imaging-model/src",
    "crates/casa-imaging-operator/src",
    "crates/casa-imaging-deconvolution/src",
    "crates/casa-imaging-products/src",
    "crates/casa-imaging-runtime/src",
    "crates/casa-imaging-metal/src",
    "crates/casa-imaging-application/src",
    "crates/casa-simulation/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\bsha2::|\\bSha256\\b|\\bcrc32c?::|\\bcrc::",
   "grandfathered": []
  },
  {
   "id": "selected-observation-provider-injection",
   "message": "selected-observation source must receive an injected Measures provider and cannot discover MeasuresRuntime",
   "roots": [
    "crates/casa-ms/src/selected_observation"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\bopen_measures_runtime\\b|\\bcasa_measures_data\\s*::\\s*(?:MeasuresRuntime|\\{[^}]*\\bMeasuresRuntime\\b)|\\bMeasuresRuntime::(?:open|open_discovered|discover_candidates)\\b|\\bopen_discovered\\b",
   "grandfathered": []
  },
  {
   "id": "definitional-crates-do-no-io",
   "message": "definitional crates define values, units, quanta, measures and coordinate systems and the pure functions on them: no file, network or process I/O and no threads (ADR-0016 decision 10); environment reads and eprintln! are refused by the rules above",
   "roots": "definitional",
   "extensions": [
    ".rs"
   ],
   "regex": "\\bstd::(?:fs|net|process)\\b|\\buse\\s+std::\\{[^}]*\\b(?:fs|net|process)\\b|\\bthread::(?:spawn|scope|Builder)\\b|\\bFile::(?:open|create)\\s*\\(",
   "grandfathered": []
  }
 ]
}
