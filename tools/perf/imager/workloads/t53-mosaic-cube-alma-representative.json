{
  "schema_version": 1,
  "id": "t53-mosaic-cube-alma-representative",
  "mode_id": "t53-mosaic-spectral-join",
  "description": "T53 representative sixteen-channel ALMA mosaic spectral join across seven overlapping pointings.",
  "dataset": {
    "key": "wave1-alma-mosaic-small",
    "root_env": "CASA_RS_IMPERF_DATA_ROOT",
    "relative_path": "wave1/alma/mosaic/small/ms/wave1-alma-mosaic-small.ms"
  },
  "imaging": {
    "mode": "dirty",
    "specmode": "cube",
    "gridder": "mosaic",
    "interpolation": "nearest",
    "field": "0,1,2,3,4,5,6",
    "spw": "0:0~17",
    "channel_start": 0,
    "channel_count": 16,
    "start": "1",
    "width": "1",
    "imsize": 512,
    "cell_arcsec": 0.08,
    "weighting": "natural",
    "perchanweightdensity": true,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "imaging_fft_backend": "rustfft",
    "deconvolver": "hogbom",
    "niter": 0,
    "minor_cycle_length": 2,
    "write_pb": true,
    "pbcor": true,
    "wterm": "none",
    "phasecenter_field": 0,
    "pblimit": 0.2
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "t53-mosaic-cube",
    "storage_label": "external-ssd",
    "evidence_role": "representative_scientific_acceptance",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    },
    "stream_log": true
  },
  "comparison": {
    "mode": "full",
    "products": [
      ".image",
      ".residual",
      ".psf",
      ".sumwt",
      ".model",
      ".weight",
      ".pb",
      ".image.pbcor"
    ],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": true,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": true,
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {
        "diff_rms_over_right_rms": 0.001
      },
      "products": {
        ".image": {
          "beam_area_relative": 0.001,
          "beam_kernel_nrmse": 0.001
        }
      }
    }
  }
}
