{
  "schema_version": 1,
  "id": "issue518-t32-vla-faceted-dirty",
  "mode_id": "faceted-mfs-dirty",
  "description": "T32 non-toy 2x2-facet dirty-image CASA parity gate on 24 channels of the full-track VLA small fixture.",
  "dataset": {
    "key": "wave1-vla-single-small",
