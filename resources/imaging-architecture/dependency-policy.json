 "source_rules": [
  {
   "id": "device-api-only-in-metal",
   "message": "device APIs are confined to casa-imaging-metal",
   "roots": [
    "libs/imaging/casa-imaging-model/src",
    "libs/imaging/casa-imaging-operator/src",
    "libs/imaging/casa-imaging-deconvolution/src",
    "libs/imaging/casa-imaging-products/src",
    "libs/imaging/casa-imaging-singledish/src",
    "libs/imaging/casa-imaging/src",
    "libs/casa/casa-simulation/src",
    "surfaces/casa-contracts/src",
    "surfaces/casa-tasks/src",
    "frontends/casars-cli/src",
    "frontends/casars-python/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:ash|cuda|cudarc|metal|objc2_metal|opencl|vulkano|wgpu)\\b|\\b(?:ash|cudarc|objc2_metal|vulkano|wgpu)::|\\b(?:MTLCreateSystemDefaultDevice|MTLCopyAllDevices)\\s*\\(",
   "grandfathered": []
  },
  {
   "id": "no-displaced-imaging-imports",
   "message": "native imaging crates and frontends must not import a displaced or execution API across the layer boundary",
   "roots": [
    "libs/imaging/casa-imaging-model/src",
    "libs/imaging/casa-imaging-operator/src",
    "libs/imaging/casa-imaging-deconvolution/src",
    "surfaces/casa-contracts/src",
    "surfaces/casa-tasks/src",
    "frontends/casars-cli/src",
    "frontends/casars-python/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "(?m)^\\s*(?:pub\\s+)?(?:use|extern\\s+crate)\\s+(?:casa_imaging_runtime|casa_imaging_metal)\\b|\\b(?:casa_imaging_runtime|casa_imaging_metal)::",
   "grandfathered": []
  },
  {
   "id": "no-env-in-imaging-libraries",
   "message": "library crates on the imaging path read no environment variables: switches are request fields or caller configuration, diagnostics are tracing events (ADR-0016, #658); resolving a relative path against the working directory (std::env::current_dir) is allowed, and the grandfathered data and state discovery waits for #709",
   "roots": [
    "libs/imaging/casa-imaging-model/src",
    "libs/imaging/casa-imaging-operator/src",
    "libs/imaging/casa-imaging-deconvolution/src",
    "libs/imaging/casa-imaging-products/src",
    "libs/imaging/casa-imaging-runtime/src",
    "libs/imaging/casa-imaging-singledish/src",
    "libs/imaging/casa-imaging-metal/src",
    "libs/imaging/casa-imaging/src",
    "libs/casa/casa-simulation/src",
    "libs/casacore/casa-fft/src",
    "libs/casacore/casa-ms/src",
    "libs/casa/casa-mstransform/src",
    "libs/casa/casa-flagging/src",
    "libs/casacore/casa-tables/src",
    "libs/casacore/casa-images/src",
    "libs/casa/casa-imageanalysis/src",
    "libs/casacore/casa-coordinates/src",
    "libs/casacore/casa-lattices/src",
    "libs/casacore/casa-numerics/src",
    "libs/casacore/casa-core/src",
    "libs/casacore/casa-aipsio/src",
    "libs/casacore/casa-measures/src"
   ],
   "exclude_roots": [],
   "extensions": [
    ".rs"
   ],
   "regex": "\\benv::var(?:_os)?\\s*\\(|\\bstd::env\\b(?!::current_dir\\b)",
   "grandfathered": [
    "libs/casacore/casa-measures/src/lib.rs"
   ]
  },
  {
   "id": "no-eprintln-in-imaging-crates",
   "message": "library crates on the imaging path emit through tracing, never eprintln! (ADR-0016, #658); the log sink is an output boundary",
   "roots": [
    "libs/imaging/casa-imaging-model/src",
    "libs/imaging/casa-imaging-operator/src",
    "libs/imaging/casa-imaging-deconvolution/src",
    "libs/imaging/casa-imaging-products/src",
    "libs/imaging/casa-imaging-runtime/src",
    "libs/imaging/casa-imaging-singledish/src",
    "libs/imaging/casa-imaging-metal/src",
    "libs/imaging/casa-imaging/src",
    "libs/casa/casa-simulation/src",
    "libs/casacore/casa-fft/src",
    "libs/casacore/casa-ms/src",
    "libs/casa/casa-mstransform/src",
    "libs/casa/casa-flagging/src",
    "libs/casacore/casa-tables/src",
    "libs/casacore/casa-images/src",
    "libs/casa/casa-imageanalysis/src",
    "libs/casacore/casa-coordinates/src",
    "libs/casacore/casa-lattices/src",
    "libs/casacore/casa-numerics/src",
    "libs/casacore/casa-core/src",
    "libs/casacore/casa-aipsio/src",
    "libs/casacore/casa-measures/src"
   ],
   "exclude_roots": [
    "libs/casacore/casa-tables/src/log_table/mod.rs"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\beprintln!\\s*\\(",
   "grandfathered": []
  },
  {
   "id": "no-content-hashing-in-imaging-crates",
   "message": "no SHA-256 or CRC over scientific arrays, plans, receipts or spill (ADR-0014/0016)",
   "roots": [
    "libs/imaging/casa-imaging-model/src",
    "libs/imaging/casa-imaging-operator/src",
    "libs/imaging/casa-imaging-deconvolution/src",
    "libs/imaging/casa-imaging-products/src",
    "libs/imaging/casa-imaging-runtime/src",
    "libs/imaging/casa-imaging-singledish/src",
    "libs/imaging/casa-imaging-metal/src",
    "libs/imaging/casa-imaging/src",
    "libs/casa/casa-simulation/src"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\bsha2::|\\bSha256\\b|\\bcrc32c?::|\\bcrc::",
   "grandfathered": []
  },
  {
   "id": "observation-geometry-provider-injection",
   "message": "the observation boundary's adapters and the batch geometry receive an injected Measures provider and cannot discover MeasuresRuntime",
   "roots": [
    "libs/casacore/casa-ms/src/observation_io",
    "libs/imaging/casa-imaging-model/src/batch_geometry"
   ],
   "extensions": [
    ".rs"
   ],
   "regex": "\\bopen_measures_runtime\\b|\\bcasa_measures_data\\s*::\\s*(?:MeasuresRuntime|\\{[^}]*\\bMeasuresRuntime\\b)|\\bMeasuresRuntime::(?:open|open_discovered|discover_candidates)\\b|\\bopen_discovered\\b",
   "grandfathered": []
  },
  {
   "id": "definitional-crates-do-no-io",
   "message": "definitional crates define values, units, quanta, measures and coordinate systems and the pure functions on them: no file, network or process I/O and no threads (ADR-0016 decision 10); environment reads and eprintln! are refused by the rules above",
   "roots": "definitional",
   "extensions": [
    ".rs"
   ],
   "regex": "\\bstd::(?:fs|net|process)\\b|\\buse\\s+std::\\{[^}]*\\b(?:fs|net|process)\\b|\\bthread::(?:spawn|scope|Builder)\\b|\\bFile::(?:open|create)\\s*\\(",
   "grandfathered": []
  }
 ],
