      "case": "2 VLA cube",
      "config": {"cfg": "vla.d.cfg", "mount": "alt-az"},
      "calls": [
        {"op": "setspwindow", "spwname": "LBAND", "freq": "1.4GHz", "deltafreq": "1MHz", "freqresolution": "1MHz", "refcode": "TOPO", "nchannels": 256, "stokes": "RR LL"},
        {"op": "setfeed", "mode": "perfect R L"},
        {"op": "setauto", "autocorrwt": 0.0},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "src", "sourcedirection": ["J2000", "13h00m00.0", "+34d00m00.0"]},
