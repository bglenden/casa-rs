        {"op": "setspwindow", "spwname": "XBAND", "freq": "8.4GHz", "deltafreq": "50MHz", "freqresolution": "50MHz", "refcode": "TOPO", "nchannels": 4, "stokes": "RR LL"},
        {"op": "settimes", "integrationtime": "20s", "usehourangle": true, "referencetime": ["UTC", "2026/06/21/12:00:00"]},
        {"op": "setfield", "sourcename": "src", "sourcedirection": ["J2000", "18h00m00.0", "+20d00m00.0"]},
        {"op": "observe", "sourcename": "src", "spwname": "XBAND", "starttime": "-200s", "stoptime": "200s"}
