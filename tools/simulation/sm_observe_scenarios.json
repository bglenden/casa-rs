{
  "schema_version": 1,
  "purpose": "simulation Phase 1c (#841): observe-only sm scenarios run by CASA and by casa-rs",
  "notes": [
    "settimes precedes setfield except in simobserve-order, so SOURCE.TIME is the reference time, not the time of open.",
    "Configurations and times keep every scenario free of shadowing, whose CASA flags are a recorded divergence."
  ],
  "scenarios": [
    {
      "name": "vla-d-rrll",
      "config": {"cfg": "vla.d.cfg", "mount": "alt-az"},
      "calls": [
        {"op": "setspwindow", "spwname": "LBAND", "freq": "1.4GHz", "deltafreq": "1MHz", "freqresolution": "1MHz", "refcode": "TOPO", "nchannels": 64, "stokes": "RR LL"},
        {"op": "setfeed", "mode": "perfect R L"},
        {"op": "settimes", "integrationtime": "10s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "src", "sourcedirection": ["J2000", "13h00m00.0", "+34d00m00.0"]},
        {"op": "observe", "sourcename": "src", "spwname": "LBAND", "starttime": "-600s", "stoptime": "-300s"},
        {"op": "observe", "sourcename": "src", "spwname": "LBAND", "starttime": "300s", "stoptime": "600s"}
      ]
    },
    {
      "name": "vla-d-rr-noauto",
      "config": {"cfg": "vla.d.cfg", "mount": "alt-az"},
      "calls": [
        {"op": "setspwindow", "spwname": "LBAND", "freq": "1.4GHz", "deltafreq": "2MHz", "freqresolution": "2MHz", "refcode": "LSRK", "nchannels": 16, "stokes": "RR"},
        {"op": "setfeed", "mode": "perfect R L"},
        {"op": "setauto", "autocorrwt": 0.0},
        {"op": "settimes", "integrationtime": "30s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "src", "sourcedirection": ["J2000", "13h00m00.0", "+34d00m00.0"]},
        {"op": "observe", "sourcename": "src", "spwname": "LBAND", "starttime": "-900s", "stoptime": "900s"}
      ]
    },
    {
      "name": "vla-a-full-elevation",
      "config": {"cfg": "vla.a.cfg", "mount": "alt-az"},
      "calls": [
        {"op": "setspwindow", "spwname": "CBAND", "freq": "5GHz", "deltafreq": "4MHz", "freqresolution": "4MHz", "refcode": "TOPO", "nchannels": 8, "stokes": "RR RL LR LL"},
        {"op": "setfeed", "mode": "perfect R L"},
        {"op": "setlimits", "shadowlimit": 1e-6, "elevationlimit": "10deg"},
        {"op": "setauto", "autocorrwt": 0.5},
        {"op": "settimes", "integrationtime": "60s", "usehourangle": true, "referencetime": ["UTC", "2026/03/21/00:00:00"]},
        {"op": "setfield", "sourcename": "low", "sourcedirection": ["J2000", "13h00m00.0", "-44d00m00.0"]},
        {"op": "observe", "sourcename": "low", "spwname": "CBAND", "starttime": "-7200s", "stoptime": "7200s"}
      ]
    },
    {
