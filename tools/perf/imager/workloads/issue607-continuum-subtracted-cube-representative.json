{
  "schema_version": 1,
  "id": "issue607-continuum-subtracted-cube-representative",
  "mode_id": "continuum-subtracted-cube-representative",
  "description": "Issue #607 representative 256-channel ALMA cube after first-order visibility-domain continuum subtraction of a structured multi-source sky.",
  "dataset": {
    "key": "issue607-contsub-v1",
    "root_env": "CASA_RS_ISSUE607_CONTSUB_ROOT",
    "relative_path": "continuum-subtraction-shaped.ms"
  },
  "imaging": {
    "mode": "dirty",
    "specmode": "cube",
    "gridder": "standard",
    "interpolation": "nearest",
    "field": "0",
    "spw": "0",
    "channel_start": 0,
    "channel_count": 256,
    "start": "0",
    "width": "1",
    "imsize": 512,
    "cell_arcsec": 0.1,
    "weighting": "natural",
    "perchanweightdensity": true,
    "parallel": false,
    "standard_mfs_acceleration": "cpu",
    "imaging_fft_precision": "auto",
    "imaging_fft_backend": "rustfft",
    "deconvolver": "hogbom",
    "niter": 0,
    "minor_cycle_length": 1,
    "fitspw": "0:0~123;132~255",
    "fitorder": 1,
    "save_continuum_residual": true,
    "casa_pblimit": -0.2,
    "write_pb": false,
    "pbcor": false,
    "wterm": "none"
  },
  "run": {
    "ms_staging": "copy",
    "repeats": 1,
    "profile_repeats": 1,
    "skip_profile": "1",
    "run_label": "issue607-continuum-subtracted-cube",
    "storage_label": "external-ssd",
    "evidence_role": "representative_scientific_acceptance",
    "env": {
      "CASA_RS_IMAGING_SPILL_READ_BYTES_PER_SECOND": "1000000000",
      "CASA_RS_IMAGING_SPILL_WRITE_BYTES_PER_SECOND": "1000000000"
    }
  },
  "comparison": {
    "mode": "full",
    "products": [".image", ".residual", ".psf", ".sumwt"],
    "max_elements_per_product": 1000000,
    "full_chunk_elements": 1000000,
    "require_exact_product_inventory": false,
    "require_direction_wcs_parity": true,
    "require_metadata_parity": false,
    "source_regions": [
      {
        "id": "line-source-region",
        "products": [".image", ".residual"],
        "blc": [192, 192],
        "trc": [319, 319]
      }
    ],
    "tolerances": {
      "contract_version": 2,
      "require_full_array": true,
      "default": {"diff_rms_over_right_rms": 0.001},
      "products": {}
    }
  }
}
